# ============================================================
# Variables de entorno del BACKEND
# Copia este archivo a `server/.env` y rellena tus valores.
# Arranca el servidor con:  node --env-file=server/.env server/index.js
# (Node 20+). Sin .env, se usan los valores demo por defecto.
# ============================================================

# Puerto del servidor backend
PORT=3001

# PINs de seguridad del panel (NO uses estos valores en producción)
MASTER_ADMIN_PIN=8888
MANAGER_ADMIN_PIN=5555
CASHIER_PIN=1978

# Hermes (WhatsApp IA) — deja vacío si no lo usas todavía
HERMES_API_URL=https://api.hermes.ai/v1
HERMES_API_KEY=

# Orígenes permitidos para CORS (coma-separado).
# En desarrollo puedes dejarlo vacío (permite *).
# En producción: https://club.turestaurante.com,https://admin.turestaurante.com
ALLOWED_ORIGINS=
