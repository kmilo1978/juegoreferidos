# ============================================================
# Variables de entorno del FRONTEND (Vite)
# Copia este archivo a `.env` y ajusta según tu entorno.
# ============================================================

# URL base de la API del backend.
# - Vacío  => usa "/api" relativo (el proxy de Vite lo redirige a :3001 en dev,
#             y en producción apunta al mismo host que sirve el frontend).
# - En producción con backend en otro host:
#   VITE_API_URL=https://api.turestaurante.com
VITE_API_URL=

# Modo demo: si es "true", el portal cautivo (kiosko) permite acceso simulado
# cuando el backend no responde. En producción debe ser "false".
VITE_DEMO_MODE=false
